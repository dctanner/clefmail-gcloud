{
  "name": "clefmail-gcloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "bun src/server.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test ./tests",
    "check:full": "bun run check && bun run test && bun run build",
    "authorize": "bun scripts/authorize.ts",
    "setup": "bun scripts/setup.ts",
    "preview": "bun scripts/preview.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
