# Local tools only. Use Secret Manager references on Cloud Run.
GOOGLE_CLIENT_ID=your-desktop-oauth-client-id
GOOGLE_CLIENT_SECRET=your-desktop-oauth-client-secret
# Export the token from .secrets/personal.token after running authorize.
GMAIL_PERSONAL_REFRESH_TOKEN=populate-privately
CLASSIFIER_API_KEY=populate-privately
CONFIG_PATH=./config.json
# Required by the server, not authorize/setup/preview.
STATE_BUCKET=your-private-clefmail-state-bucket
PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/clefmail-gcloud
GMAIL_TOPIC=projects/your-project/topics/clefmail-gcloud
